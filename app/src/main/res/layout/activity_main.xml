<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/mainLayout"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_above="@+id/adView"
        android:layout_height="match_parent"
        tools:context="com.gitlab.mudlej.MjPdfReader.ui.main.MainActivity">

        <com.github.barteksc.pdfviewer.PDFView
            android:id="@+id/pdfView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/pickFile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/brand_ground"
            android:orientation="vertical"
            android:paddingTop="12dp">

            <!-- Bento header: greeting + big title, square actions on the right. -->
            <LinearLayout
                android:id="@+id/relative"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/homeGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jakarta_medium"
                        android:textColor="@color/brand_textMuted"
                        android:textSize="15sp"
                        tools:text="Good evening" />

                    <TextView
                        android:id="@+id/actionbarTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/jakarta_extrabold"
                        android:letterSpacing="-0.03"
                        android:text="@string/home_title"
                        android:textColor="@color/brand_text"
                        android:textSize="32sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/info"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_square_action"
                    android:contentDescription="@string/about"
                    android:padding="11dp"
                    android:src="@drawable/info_icon"
                    app:tint="@color/brand_text" />

                <ImageView
                    android:id="@+id/settings"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_square_action"
                    android:contentDescription="@string/settings"
                    android:padding="11dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/brand_text" />
            </LinearLayout>

            <!-- Hero tile: the main action, in the app accent. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/homeHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@animator/press_scale"
                app:cardBackgroundColor="@color/brand_accent"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1">

                            <View
                                android:layout_width="34dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="30dp"
                                android:alpha="0.5"
                                android:background="@drawable/bg_page_white"
                                android:rotation="10" />

                            <View
                                android:layout_width="34dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="16dp"
                                android:alpha="0.75"
                                android:background="@drawable/bg_page_white"
                                android:rotation="3" />

                            <View
                                android:layout_width="34dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_page_white"
                                android:rotation="-7" />
                        </FrameLayout>

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_hero_plus"
                            android:importantForAccessibility="no"
                            android:padding="12dp"
                            android:src="@drawable/ic_plus_bento"
                            app:tint="@color/brand_onAccent" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/jakarta_bold"
                        android:letterSpacing="-0.02"
                        android:text="@string/home_hero_title"
                        android:textColor="@color/brand_onAccent"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:alpha="0.85"
                        android:fontFamily="@font/jakarta_medium"
                        android:text="@string/home_hero_body"
                        android:textColor="@color/brand_onAccent"
                        android:textSize="14sp" />

                    <!-- Kept for code compatibility; the whole tile opens the picker. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/homeOpenButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pastel tool tiles. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/homeTilePdf"
                    style="@style/Bento.Tile"
                    android:layout_marginEnd="5dp">

                    <LinearLayout style="@style/Bento.TileBody">

                        <ImageView
                            style="@style/Bento.TileIcon"
                            android:backgroundTint="@color/tile_pdf_bg"
                            android:src="@drawable/ic_doc_outline"
                            app:tint="@color/tile_pdf_fg" />

                        <TextView
                            style="@style/Bento.TileLabel"
                            android:text="@string/home_tile_pdf" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/homeTileEpub"
                    style="@style/Bento.Tile"
                    android:layout_marginStart="5dp">

                    <LinearLayout style="@style/Bento.TileBody">

                        <ImageView
                            style="@style/Bento.TileIcon"
                            android:backgroundTint="@color/tile_epub_bg"
                            android:src="@drawable/ic_open_book"
                            app:tint="@color/tile_epub_fg" />

                        <TextView
                            style="@style/Bento.TileLabel"
                            android:text="@string/home_tile_epub" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/jakarta_bold"
                android:text="@string/recent_file"
                android:textColor="@color/brand_text"
                android:textSize="17sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- Recent files grouped in one white card. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/recentCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/brand_card"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycle_view_pdfs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:paddingVertical="4dp" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/empty_folder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="40dp"
                    android:paddingTop="24dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_round_12"
                        android:backgroundTint="@color/brand_accentContainer"
                        android:importantForAccessibility="no"
                        android:padding="18dp"
                        android:src="@drawable/ic_doc_outline"
                        app:tint="@color/brand_accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/jakarta_bold"
                        android:text="@string/home_empty_title"
                        android:textColor="@color/brand_text"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/jakarta_medium"
                        android:gravity="center"
                        android:text="@string/home_empty_body"
                        android:textColor="@color/brand_textMuted"
                        android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/landing_open_fab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:srcCompat="@drawable/plus"
                tools:ignore="ContentDescription" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-6dp"
            android:layout_gravity="top"
            android:indeterminate="true"
            android:visibility="gone" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/secondBarLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@color/dark_blue"
                app:layout_constraintTop_toTopOf="parent"
                />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start"
                android:padding="10dp"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/secondBarLayout"
                >

                <LinearLayout
                    android:id="@+id/exitFullScreenButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/exitFullScreenImage"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:src="@drawable/close_icon"
                        android:background="@drawable/button_background"
                        android:shadowColor="#ffffff"
                        android:shadowDx="1.5"
                        android:shadowDy="1.5"
                        android:shadowRadius="3"
                        android:contentDescription="@string/exit_fullscreen_button" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rotateScreenButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:visibility="invisible">

                    <ImageView
                        android:id="@+id/rotateScreenImage"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_screen_rotate"
                        android:background="@drawable/button_background"
                        android:shadowColor="#ffffff"
                        android:shadowDx="1.5"
                        android:shadowDy="1.5"
                        android:shadowRadius="3"
                        android:contentDescription="@string/rotate_screen" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/brightnessButtonLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:visibility="invisible"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/brightnessButton"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_brightness"
                        android:background="@drawable/button_background"
                        android:shadowColor="#ffffff"
                        android:shadowDx="1.5"
                        android:shadowDy="1.5"
                        android:shadowRadius="3"
                        android:contentDescription="@string/rotate_screen" />

                    <androidx.appcompat.widget.AppCompatSeekBar
                        android:id="@+id/brightnessSeekBar"
                        android:layout_height="match_parent"
                        android:layout_width="200dp"
                        android:layout_marginStart="8dp"
                        android:thumbTint="@color/topBarBackgroundColor"
                        android:progressTint="@color/topBarBackgroundColor"
                        android:background="@drawable/seekbar_background"
                        android:visibility="invisible"
                        />

                    <TextView
                        android:id="@+id/brightnessPercentage"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:padding="4dp"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/topBarBackgroundColor"
                        android:background="@drawable/seekbar_background"
                        android:text="35%"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:visibility="invisible"
                        />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/autoScrollLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:visibility="invisible"
                    android:orientation="horizontal"
                    android:divider="@drawable/auto_scroll_button_divider"
                    android:showDividers="middle">

                    <ImageView
                        android:id="@+id/autoScrollButton"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:padding="2dp"
                        android:layout_marginEnd="3dp"
                        android:src="@drawable/ic_auto_scroll"
                        android:background="@drawable/button_background"
                        android:shadowColor="#ffffff"
                        android:shadowDx="1.5"
                        android:shadowDy="1.5"
                        android:shadowRadius="3"
                        />

                    <ImageView
                        android:id="@+id/reverseAutoScrollButton"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="2dp"
                        android:layout_marginHorizontal="3dp"
                        android:src="@drawable/ic_reverse_direction"
                        android:background="@drawable/seekbar_background"
                        android:visibility="invisible"
                        />

                    <ImageView
                        android:id="@+id/decreaseScrollSpeedButton"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="2dp"
                        android:layout_marginHorizontal="3dp"
                        android:src="@drawable/ic_decrease"
                        android:background="@drawable/seekbar_background"
                        android:visibility="invisible"
                        />

                    <ImageView
                        android:id="@+id/increaseScrollSpeedButton"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="2dp"
                        android:layout_marginHorizontal="3dp"
                        android:src="@drawable/ic_increase"
                        android:background="@drawable/seekbar_background"
                        android:visibility="invisible"
                        />

                    <ImageView
                        android:id="@+id/toggleAutoScrollButton"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="2dp"
                        android:layout_marginHorizontal="3dp"
                        android:src="@drawable/ic_start"
                        android:background="@drawable/seekbar_background"
                        android:visibility="invisible"
                        />

                    <TextView
                        android:id="@+id/autoScrollSpeedText"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:layout_marginHorizontal="3dp"
                        android:textColor="@color/topBarBackgroundColor"
                        android:background="@drawable/seekbar_background"
                        tools:text="1"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:visibility="invisible"
                        />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toggleHorizontalSwipeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:visibility="invisible">

                    <ImageView
                        android:id="@+id/toggleHorizontalSwipeImage"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:padding="2dp"
                        android:src="@drawable/ic_horizontal_swipe_locked"
                        android:background="@drawable/button_background"
                        android:shadowColor="#ffffff"
                        android:shadowDx="1.5"
                        android:shadowDy="1.5"
                        android:shadowRadius="3" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/screenshotButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:visibility="invisible">

                    <ImageView
                        android:id="@+id/screenshotImage"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:padding="2dp"
                        android:src="@drawable/ic_screenshot"
                        android:background="@drawable/button_background"
                        android:shadowColor="#ffffff"
                        android:shadowDx="1.5"
                        android:shadowDy="1.5"
                        android:shadowRadius="3"
                        android:contentDescription="@string/rotate_screen" />
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <!-- Anchored adaptive banner is added here by BannerHelper once consent allows ad requests. -->
    <FrameLayout
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true" />
</RelativeLayout>

