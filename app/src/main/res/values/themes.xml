<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
<!--        <item name="android:windowTranslucentStatus">true</item>-->
<!--        <item name="android:windowTranslucentNavigation">true</item>-->
    </style>

    <style name="MJ_PDF_THEME" parent="Theme.MaterialComponents.DayNight.DarkActionBar.Bridge" >
        <item name="android:actionOverflowButtonStyle">@style/MJ_PDF_THEME.OverFlow</item>
        <item name="actionOverflowMenuStyle">@style/CMOptionsMenu</item>
        <item name="colorPrimary">@color/dark_blue</item>
        <item name="colorPrimaryDark">@color/dark_blue</item>
        <item name="colorAccent">@color/brand_accent</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorOnSecondary">@color/brand_onAccent</item>
        <item name="android:windowBackground">@color/brand_ground</item>
        <item name="statusBarBackground">@color/dark_blue</item>
        <item name="android:itemTextAppearance">@style/TextAppearance</item>
    </style>
    <style name="Setting_Theme" parent="Theme.MaterialComponents.DayNight.DarkActionBar.Bridge" >
        <item name="android:actionOverflowButtonStyle">@style/MJ_PDF_THEME.OverFlow</item>
        <item name="actionOverflowMenuStyle">@style/CMOptionsMenu</item>
        <item name="colorPrimary">@color/dark_blue</item>
        <item name="colorPrimaryDark">@color/dark_blue</item>
        <item name="colorAccent">@color/brand_accent</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="statusBarBackground">@color/dark_blue</item>
        <item name="android:itemTextAppearance">@style/TextAppearance</item>
    </style>

    <!-- to change (color and margin) of the more icon option in the appBar   -->
    <style name="MJ_PDF_THEME.OverFlow">
<!--        <item name="android:src">@drawable/ic_more_vert</item>-->
        <item name="android:src">@drawable/ic_more_vert</item>
        <item name="android:padding" tools:targetApi="o">12dp</item>

    </style>

    <!-- To change the background of options menu-->
    <style name="CMOptionsMenu" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@color/dark_blue</item>
    </style>

    <!-- To change text color of items in options menu-->
    <style name="TextAppearance">
        <item name="android:textColor">@color/topBarColor</item>
    </style>


    <style name="MJDialogThemeDark" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:background">@color/topBarBackgroundColor</item>
        <item name="android:textColor">@color/topBarColor</item>
        <item name="textColorAlertDialogListItem">@color/topBarColor</item>
        <item name="buttonBarPositiveButtonStyle">@color/topBarColor</item>
        <item name="buttonBarNegativeButtonStyle">@color/topBarColor</item>
    </style>

    <style name="MJDialogThemeLight" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:textColor">@color/topBarBackgroundColor</item>
        <item name="android:positiveButtonText">@color/topBarBackgroundColor</item>
        <item name="android:negativeButtonText">@color/topBarBackgroundColor</item>
    </style>

    <!-- Bento tool tile -->
    <style name="Bento.Tile" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="cardBackgroundColor">@color/brand_card</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Bento.TileBody" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="Bento.TileIcon" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">9dp</item>
        <item name="android:background">@drawable/bg_round_12</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="Bento.TileLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:fontFamily">@font/jakarta_semibold</item>
        <item name="android:textColor">@color/brand_text</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>